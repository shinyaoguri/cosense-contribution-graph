{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cosense-grass",
  "main": "src/worker/index.ts",

  // 誤アカウント防止の二重化 (ADR-0014 決定 4)。認証プロファイルの束縛が外れていても、
  // ここで対象が固定される。アカウント ID は秘密ではないのでコミットしてよい。
  "account_id": "d82286ae14a7c357b84e19863fe9f220",

  // compatibility_flags は書かない。2026-08-04 以降の compatibility_date では
  // nodejs_compat / nodejs_compat_v2 が既定で有効で、公式が省略を勧めている。
  "compatibility_date": "2026-09-12",

  // **invocation logs は切る** (ADR-0013 の 2026-09-14 の改訂)。/v1/p.gif の URL には uid と署名が載るので、
  // リクエストの URL が記録されると「uid をログに出さない」(ADR-0013 決定 1) に反する。
  // 記録されるかは確かめていないので安全側に倒す。console.log の 1 行ログは残る
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },

  // 既定でも有効 (routes が空なら workers.dev が有効になる) だが明示する。
  // routes を足した瞬間に既定が無効へ変わり、すでに貼られた workers.dev の URL が壊れるため。
  //
  // **独自ドメイン grass.soui.dev はダッシュボードの Custom Domain で付けていて、ここに routes を書かない**
  // (ADR-0014 決定 10)。routes が空なら wrangler deploy はルートにもカスタムドメインにも触らない (research §5)。
  // 書くと CI 用トークンにゾーンの権限が要り、replace_state で宣言に無いドメインを外す。
  "workers_dev": true,

  // **バインディングは使っているコードに合わせて足していく** (secrets.required と同じ規則)。
  // `--dry-run` と違って本番デプロイはバインディングを実アカウントと照合するので、
  // 使っていないものを宣言すると初回デプロイがそれで落ちうる。
  //
  // - ratelimits — Free プランで使えるかが段階 2 の実機検証項目。検証してから足す
  //                (INGEST_LIMITER 60/60s、ENROLL_LIMITER 5/60s の予定。design §6)

  // データベースは CI の deploy ジョブが無ければ作る (`wrangler d1 create cosense-grass --location apac`。
  // ADR-0014 決定 9)。**ID は初回に作ったときの Actions のログから取って固定した** (2026-09-14、APAC、Issue #36)。
  // ID を書かないと wrangler は名前でデータベースを探し、消えていれば黙って空のものを作り直しうる。
  // 固定しておけば、消えたときにマイグレーションの段で落ちて気付ける。ID は秘密ではない
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cosense-grass",
      "database_id": "87006345-0057-4f0d-92ab-6ef303719c79",
      "migrations_dir": "migrations"
    }
  ],

  // 秘密ではない設定。**ダッシュボードで vars を足さない** (keep_vars を付けていないので、
  // デプロイのたびにここの内容に置き換わる。research §5)。
  "vars": {
    // Google Cloud の OAuth クライアント (段階 4、Issue #61)。クライアント ID は公開情報
    "GOOGLE_CLIENT_ID": "1019787027635-rqednvrt9cm4p5bk6uu3lgjf318162l6.apps.googleusercontent.com",
    // redirect_uri と認証の cookie の基準 (ADR-0014 決定 10)。ローカルでは .dev.vars で上書きできる
    "PUBLIC_ORIGIN": "https://grass.soui.dev"
  },

  // UTC。デプロイのたびに内容で置き換わるので、空配列にすると全削除される。
  "triggers": { "crons": ["17 3 * * *"] },

  // デプロイ前に未設定の secret を列挙してエラーで止まる。wrangler types の
  // 型生成もここを見るので、.dev.vars が無い CI でも Env の型が安定する。
  //
  // **使っているコードに合わせて足していく。** Worker がまだ無い状態の初回デプロイは、
  // ここに宣言した secret が揃わないと必ず失敗する。使わない secret まで宣言すると、
  // 仮の値を本番に置くことになる。**足したら .github/workflows/ci.yml の names も足す。**
  //
  // WORKER_SECRET は一度決めたら変えられない (変えると全利用者の識別子が変わる)。
  // GOOGLE_CLIENT_SECRET は OAuth クライアントのもの (段階 4、Issue #61)。
  // 値は GitHub の production 環境にあり、CI が毎回 --secrets-file で渡す。
  "secrets": { "required": ["WORKER_SECRET", "GOOGLE_CLIENT_SECRET"] }
}
