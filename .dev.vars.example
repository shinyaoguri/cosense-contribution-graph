# ローカル開発用の秘密値のひな形。**実際の値を書いたら .dev.vars にコピーする**
# (.dev.vars は gitignore 済み)。wrangler dev がこれを読む。
#
# wrangler.jsonc の secrets.required に宣言してあるので、未設定だと警告が出る。
# 本番の値は GitHub Actions から wrangler deploy --secrets-file で投入する。
# ローカルに CLOUDFLARE_API_TOKEN は置かない (ADR-0014 決定 3)。

# 利用者の識別子を導出する鍵。**失うと全利用者の識別子が再計算できなくなる**
WORKER_SECRET=dummy-not-a-real-secret

# OAuth クライアントの secret。ダミーのままでは Google とのやり取りは通らない
GOOGLE_CLIENT_SECRET=dummy-not-a-real-secret

# ローカルで OAuth を実際に通すときだけ、開発用の OAuth クライアント (リダイレクト URI が
# http://localhost:8787/auth/callback) を別に作り、次を置く。**本番のクライアントの secret は置かない**
# PUBLIC_ORIGIN=http://localhost:8787
# GOOGLE_CLIENT_ID=<開発用のクライアント ID>
